# ベクトルAPI（開発時プロキシ先）
VITE_BACKEND_URL=http://127.0.0.1:8000

# Desktopキャプチャの転送方式
# - post: Electronで取得した音声チャンクを /pipeline/transcribe-analyze へPOST（既存方式）
# - swift_ws: Swift Capture Agent (WebSocket) 経由で transcript/event を受信
VITE_DESKTOP_CAPTURE_TRANSPORT=post

# Swift Capture Agent WebSocket（transport=swift_ws のときのみ使用）
VITE_SWIFT_AGENT_WS_URL=ws://127.0.0.1:55100/ws
VITE_SWIFT_AGENT_WS_PROTOCOL=lexiflow.capture.v1

# 前回送信とかぶらせる文の数（未設定時は 5）
VITE_VECTOR_OVERLAP_SENTENCES=5

# 新規にこの文数たまったら送信（未設定時は 5。0で無効）
VITE_VECTOR_SEND_EVERY_N_SENTENCES=10

# この秒数ごとに送信（0で無効）。文数トリガーと併用可
VITE_VECTOR_SEND_INTERVAL_SEC=60
