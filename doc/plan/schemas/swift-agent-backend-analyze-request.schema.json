{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lexiflow.local/schemas/swift-agent-backend-analyze-request.schema.json",
  "title": "Swift Agent -> Backend analyze-text request",
  "type": "object",
  "required": [
    "session_id",
    "source",
    "utterance_id",
    "seq",
    "text",
    "is_final",
    "start_ms",
    "end_ms"
  ],
  "properties": {
    "session_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "source": {
      "type": "string",
      "enum": [
        "microphone",
        "system_audio"
      ]
    },
    "utterance_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "seq": {
      "type": "integer",
      "minimum": 0
    },
    "text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 20000
    },
    "is_final": {
      "type": "boolean"
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "language": {
      "type": "string",
      "default": "ja-JP"
    },
    "start_ms": {
      "type": "integer",
      "minimum": 0
    },
    "end_ms": {
      "type": "integer",
      "minimum": 0
    },
    "include_dictionary": {
      "type": "boolean",
      "default": true
    },
    "dictionary_top_k": {
      "type": "integer",
      "minimum": 1,
      "maximum": 50,
      "default": 5
    },
    "deduplicate": {
      "type": "boolean",
      "default": false
    },
    "min_length": {
      "type": "integer",
      "minimum": 1,
      "maximum": 64,
      "default": 1
    },
    "normalize_sentence_vector": {
      "type": "boolean",
      "default": true
    },
    "metadata": {
      "type": "object",
      "properties": {
        "agent_version": {
          "type": "string"
        },
        "device_name": {
          "type": "string"
        }
      },
      "additionalProperties": true
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "is_final": {
            "const": false
          }
        }
      },
      "then": {
        "properties": {
          "include_dictionary": {
            "const": false
          }
        }
      }
    }
  ],
  "additionalProperties": false
}

